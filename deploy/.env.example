# Секрет auth (обязателен, >= 16 символов). Если оставить пустым — скрипт
# install_new_server.sh сгенерирует его сам в .env при первом запуске.
PP_AUTH_SECRET=

# Почта для сброса пароля (необязательно; без неё код — dev-режим: код
# восстановления возвращается в ответе forgot).
PP_SMTP_HOST=
PP_SMTP_PORT=587
PP_SMTP_USER=
PP_SMTP_PASSWORD=
PP_SMTP_FROM=

# SMS-подтверждение телефона при регистрации. dev (по умолчанию) — реальной
# отправки нет, код возвращается в ответе register/resend; до подключения
# провайдера на публичном проде обязательно сменить!
PP_SMS_PROVIDER=dev
# Реальный провайдер sms.ru: api_id из личного кабинета (раздел
# «Программистам»); при PP_SMS_PROVIDER=sms_ru обязателен.
PP_SMS_API_ID=
# 1 = режим test=1 у sms.ru: ответ проверяется, SMS не отправляется
# и баланс не расходуется (для проверки интеграции).
PP_SMS_TEST=0
# Кулдаун переотправки кода подтверждения, секунд.
PP_RESEND_COOLDOWN=60

# --- Billing (ЮKassa, ADR-3: чек-аут + webhook + entitlement) ---
# Ключи личного кабинета ЮKassa; в compose по умолчанию test_shop/test_secret —
# для прода задайте реальные значения (и не коммитьте их).
YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=
# Секрет проверки HMAC-SHA256 подписи вебхука. Обязателен в проде: пустой →
# сервис отклоняет уведомления ЮKassa (fail closed, 503).
YUKASSA_WEBHOOK_SECRET=
YUKASSA_API_URL=https://api.yookassa.ru/v3
# 1 — просить сохранить способ оплаты (автоплатежи; нужна активация у мерчанта).
YUKASSA_SAVE_PAYMENT_METHOD=0
# Чек (ADR-3): 1 — добавлять объект receipt в создание платежа, 0 — без чека.
YUKASSA_RECEIPT_ENABLED=1
# Код НДС в чеке ЮKassa: 1 — НДС включён в цену (по умолчанию).
YUKASSA_RECEIPT_VAT_CODE=1
# Публичный origin для return_url после оплаты (единый origin, ADR-6).
PP_PUBLIC_BASE=https://example.com
PP_RETURN_PATH=/billing/return

# Пароль PostgreSQL (используется postgresql/auth/billing/api).
PP_DB_PASSWORD=

# --- Объектное хранилище (ADR-5: гибрид S3 + PostgreSQL) ---
# Ключи MinIO/S3. Дефолты minioadmin/minioadmin — только для dev; в проде
# задайте свои (api/minio читают их из этих же переменных).
PP_OBJECT_STORAGE_ACCESS_KEY=
PP_OBJECT_STORAGE_SECRET_KEY=
# Публичный origin для presigned URL: им же пользуется api
# (OBJECT_STORAGE_PUBLIC_ENDPOINT=${PP_PUBLIC_BASE}, ссылки вида
# https://example.com/s3/<bucket>/org/...). Пусто → ссылки указывают на
# внутренний minio:9000 (браузер их не откроет — используйте режим потока).
# PP_PUBLIC_BASE выше уже задаёт origin.

# --- Лимиты API для файлов (проекты и файлы в облаке) ---
# Размер файла (МБ) и срок жизни presigned-ссылки (секунды).
PP_MAX_MB=50
PP_PRESIGN_TTL=300
# Сколько версий файла хранится (старые вычищаются soft delete).
PP_MAX_FILE_VERSIONS=20
# 1 — спрашивать billing о лимите проектов (Free: 1 проект); 0 — не гейтить.
PP_ENTITLEMENT_ENFORCE=1
# --- Mandatory production variables (must be filled before deploy) ---
# Auth secret (min 16 chars)
PP_AUTH_SECRET=REPLACE_WITH_MIN_32_CHAR_SECRET
# PostgreSQL password (strong, unique)
PP_DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
# SMTP (transactional provider: Selectel Mail / Yandex 360 / Mailgun)
PP_SMTP_HOST=smtp.example.com
PP_SMTP_PORT=587
PP_SMTP_USER=noreply@example.com
PP_SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
PP_SMTP_FROM=noreply@example.com
# ЮKassa (production account)
YUKASSA_SHOP_ID=REPLACE_WITH_REAL_SHOP_ID
YUKASSA_SECRET_KEY=REPLACE_WITH_REAL_SECRET_KEY
YUKASSA_WEBHOOK_SECRET=REPLACE_WITH_REAL_WEBHOOK_SECRET
YUKASSA_API_URL=https://api.yookassa.ru/v3
YUKASSA_SAVE_PAYMENT_METHOD=1
# Public origin for webhooks and presigned URLs
PP_PUBLIC_BASE=https://example.com
PP_RETURN_PATH=/billing/return
# Default organization for registration (1 = create default org; 0 = no default)
PP_DEFAULT_ORG=1
# Storage (S3-compatible; if using MinIO, set MINIO keys; if real S3, use S3 endpoint)
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_BUCKET=prepress-saas
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin

# --- Offsite-копия бэкапов (deploy/backup.sh шаг 3; см. deploy/README.md) ---
# Без PP_OFFSITE_S3_BUCKET шаг пропускается. Пример (S3-совместимый провайдер):
# PP_OFFSITE_S3_BUCKET=backups-pp
# PP_OFFSITE_S3_ENDPOINT=https://s3.eu-central.io.cloud.ru   # пусто → AWS S3
# PP_OFFSITE_S3_REGION=ru-1
# PP_OFFSITE_S3_PREFIX=prepress-backups
# PP_OFFSITE_ACCESS_KEY_ID=REPLACE_WITH_OFFSITE_KEY_ID
# PP_OFFSITE_SECRET_ACCESS_KEY=REPLACE_WITH_OFFSITE_SECRET
