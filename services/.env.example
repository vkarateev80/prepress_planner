# Секрет auth (обязателен, ≥ 16 символов). Сгенерируйте свой:
#   python -c "import secrets; print(secrets.token_hex(32))"
PP_AUTH_SECRET=

# Регистрация без org_name: 1 (по умолчанию) — создаётся личная организация,
# 0 — пользователь без организации (memberships добавляются позже).
PP_DEFAULT_ORG=1

# Сроки: сессия (часы, по умолчанию 720 = 30 дней), код сброса (минуты).
PP_TOKEN_TTL=720
PP_RESET_TTL=30

# Почта для сброса пароля (нужна в проде: код в ответе не возвращается).
PP_SMTP_HOST=
PP_SMTP_PORT=587
PP_SMTP_USER=
PP_SMTP_PASSWORD=
PP_SMTP_FROM=
# 1 = TLS сразу (обычно порт 465), пусто = STARTTLS на PP_SMTP_PORT.
PP_SMTP_SSL=

# --- Billing (ЮKassa, ADR-3) ---
# Ключи личного кабинета ЮKassa. Пустые → checkout/возврат отвечают 503
# («ЮKassa не настроена»); тестового подтверждения оплаты в сервисе нет.
YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=
# Секрет проверки HMAC-SHA256 подписи вебхука. Пустой → вебхук отклоняется (503).
YUKASSA_WEBHOOK_SECRET=
# API ЮKassa (для песочницы можно подменить хостом тестового контура).
YUKASSA_API_URL=https://api.yookassa.ru/v3
# 1 — просить сохранить способ оплаты (автоплатежи; нужна активация у мерчанта).
YUKASSA_SAVE_PAYMENT_METHOD=0
# Триал и цены (триал ведёт billing, а не провайдер).
PP_TRIAL_DAYS=15
PP_PRO_MONTH_PRICE_RUB=990
PP_PRO_YEAR_PRICE_RUB=9900
# Публичный origin для return_url после оплаты (единый origin, ADR-6).
PP_PUBLIC_BASE=
# Пароль БД при DB_URL=postgresql://… (в services/docker-compose.yml — SQLite).
PP_DB_PASSWORD=

# --- API (проекты и файлы в облаке; ADR-5, N-4) ---
# Хранилище объектов: memory (dev, без MinIO) | s3 (MinIO/S3, профиль storage).
PP_STORAGE_BACKEND=memory
OBJECT_STORAGE_ENDPOINT=http://minio:9000
# Endpoint, попадающий в presigned URL (dev: опубликованный порт MinIO 9010).
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://127.0.0.1:9010
OBJECT_STORAGE_BUCKET=prepress-saas
PP_OBJECT_STORAGE_ACCESS_KEY=
PP_OBJECT_STORAGE_SECRET_KEY=
# Лимиты: размер файла (МБ), TTL presigned-ссылки (с), число версий на файл.
PP_MAX_MB=50
PP_PRESIGN_TTL=300
PP_MAX_FILE_VERSIONS=20
# 1 — обязательный Bearer-токен (прод); 0 — dev-тенант PP_DEV_ORG_ID.
PP_AUTH_REQUIRED=1
# 1 — гейтинг по entitlement billing (Free: 1 проект); 0 — без гейтинга.
PP_ENTITLEMENT_ENFORCE=0

# --- S3-совместимое хранилище (MinIO, профиль `storage`) ---
# docker compose --profile storage up -d --build
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
